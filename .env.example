# Copy this file to ".env" (same folder) and fill in the values you want.
# .env is gitignored — your real key never gets committed.
#
# Leave everything commented out / .env absent entirely -> the pipeline runs
# on the deterministic template generator only (LLM_PROVIDER defaults to
# "mock"). This is a fully valid, fully tested configuration; adding a real
# key only adds LLM-generated paraphrase variety and the guarded symptom
# classification fallback for otherwise-unclassifiable complaints (see
# README.md's "Guarded LLM fallback classifier" section) — it does not
# change correctness.

# Pick ONE provider and uncomment its two lines.

# --- Gemini (recommended: free tier, no credit card required) ---
# Get a key at https://aistudio.google.com
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your-key-here

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# Optional, any provider: override the default model
# LLM_MODEL=gemini-3.5-flash-lite
